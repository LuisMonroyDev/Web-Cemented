# Backend environment variables.
#
# The development skeleton runs WITHOUT a .env file — dev.py has safe local
# defaults. You only need a real .env once you deploy, or once you wire up
# Stripe / email. Copy this file to .env and fill values in as features need them.

# --- Django core ---
DJANGO_SECRET_KEY=          # required in production; dev.py has an insecure fallback
DJANGO_ALLOWED_HOSTS=       # comma-separated hostnames, production only

# --- Database (production) ---
DATABASE_URL=               # postgres URL, e.g. postgresql://user:pass@localhost:5432/cemented; dev uses local SQLite

# --- Media (production) ---
DJANGO_MEDIA_ROOT=          # absolute path for uploaded images; point at the DO Volume mount, e.g. /mnt/cemented_media. Blank = BASE_DIR/media

# --- CORS ---
FRONTEND_ORIGIN=            # comma-separated frontend origins, production only

# --- Stripe (added with the checkout feature) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
CHECKOUT_SUCCESS_URL=       # frontend URL Stripe returns to on success (dev defaults to localhost:5173)
CHECKOUT_CANCEL_URL=        # frontend URL Stripe returns to on cancel

# --- Email (added with the order-confirmation feature) ---
EMAIL_API_KEY=              # Resend API key; without it, dev prints emails to the console
BAND_NOTIFICATION_EMAIL=    # where new-order notifications are sent
DEFAULT_FROM_EMAIL=         # verified sender, e.g. "Cemented <orders@yourdomain>"
