# Backend environment variables.
#
# The development skeleton runs WITHOUT a .env file — dev.py has safe local
# defaults. You only need a real .env once you deploy, or once you wire up
# Stripe / email. Copy this file to .env and fill values in as features need them.

# --- Django core ---
DJANGO_SECRET_KEY=          # required in production; dev.py has an insecure fallback
DJANGO_ALLOWED_HOSTS=       # comma-separated hostnames, production only

# --- Database (production) ---
DATABASE_URL=               # provided by Railway/Render; dev uses local SQLite

# --- CORS ---
FRONTEND_ORIGIN=            # comma-separated frontend origins, production only

# --- Stripe (added with the checkout feature) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Email (added with the order-confirmation feature) ---
EMAIL_API_KEY=
BAND_NOTIFICATION_EMAIL=
